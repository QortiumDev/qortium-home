    "build:renderer": "vite build --config vite.home-v2.config.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:v2-fixture:renderer": "vite build --config vite.v2-fixture.config.ts",
    "build:v2-fixture:electron": "tsc -p electron/tsconfig.v2-fixture.json",
    "build:v2-fixture:stage": "node scripts/stage-home-v2-fixture.mjs",
    "build:v2-fixture": "npm run clean:v2-fixture && npm run build:v2-fixture:renderer && npm run build:v2-fixture:electron && npm run build:v2-fixture:stage",
