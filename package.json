    "dist:linux:all": "npm run build && electron-builder --linux AppImage --x64 --arm64 && npm run chmod:linux:appimages && npm run check:linux:appimage -- --arch=x64 && npm run check:linux:appimage -- --arch=arm64",
    "dist:linux:x64:v2-fixture": "npm run build:v2-fixture && electron-builder --projectDir .v2-fixture-package --config electron-builder.json --linux AppImage --x64 --publish never && npm run chmod:linux:v2-fixture-appimages && npm run check:v2-fixture:artifact",
    "dist:mac:x64": "npm run build:native:macos && npm run build && electron-builder --mac dmg --x64 --publish never && npm run check:macos:core-observer -- \"dist-release/mac/Qortium Home.app\"",
    "dist:mac:arm64": "npm run build:native:macos && npm run build && electron-builder --mac dmg --arm64 --publish never && npm run check:macos:core-observer -- \"dist-release/mac-arm64/Qortium Home.app\"",
