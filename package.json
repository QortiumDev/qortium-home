    "@capacitor/preferences": "^8.0.1",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "asmcrypto.js": "2.3.2",
    "bcryptjs": "2.4.3",
    "ed2curve": "0.3.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "marked": "^14.1.4",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "tar": "^7.5.22",
    "tweetnacl": "1.0.3",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/ed2curve": "0.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "ws": "^8.21.3"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    },
    "tmp": "0.2.7",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "org.qortium.home",
    "productName": "Qortium Home",
    "artifactName": "Qortium-Home-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*",
          "!**/*.test.js",
          "!.tsbuildinfo",
          "!v2-fixture-main.js"
        ]
      },
      "package.json",
      "!**/node_modules/**/android/build/**",
      "!**/node_modules/@napi-rs/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage"
        }
      ],
      "category": "Network",
      "executableName": "qortium-home",
      "syncDesktopName": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "x64ArchFiles": "Contents/Resources/native/macos/{x64,arm64}/qortium-core-observer",
      "extraResources": [
        {
          "from": ".native-build/macos",
          "to": "native/macos",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "backgroundColor": "#ffffff",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": ".native-build/windows",
          "to": "native/windows",
          "filter": [
            "x64/qortium-core-observer.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "electron@36.9.5": true,
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.7": true
  }
}
